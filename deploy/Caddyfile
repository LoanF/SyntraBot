# Relais interne en HTTP : le TLS (certificats Let's Encrypt) est géré par le reverse proxy HAProxy placé devant.
# Caddy ne publie qu'un port HTTP (HTTP_PORT, 8080 par défaut) et ne demande aucun certificat.
{
	auto_https off
	servers {
		# Fait confiance aux en-têtes X-Forwarded-* de HAProxy (réseau privé) : vraie IP client, https
		trusted_proxies static private_ranges
	}
}

http://{$WEB_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

http://{$API_DOMAIN} {
	encode zstd gzip
	# Corps limité : l'API valide déjà 256 Ko, on coupe plus tôt
	request_body {
		max_size 512KB
	}
	reverse_proxy api:4000 {
		# Le long-polling du bridge FiveM dure jusqu'à ~25 s
		transport http {
			response_header_timeout 40s
		}
	}
}
