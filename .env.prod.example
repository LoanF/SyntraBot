# Copier en .env.prod (jamais commité) puis remplir. Générer les secrets : openssl rand -base64 32
WEB_DOMAIN=console.exemple.fr
API_DOMAIN=api.exemple.fr
# Port HTTP interne du LXC vers lequel HAProxy renvoie (le TLS est géré par HAProxy)
HTTP_PORT=8080

POSTGRES_PASSWORD=
DATABASE_URL=postgresql://syntra:CHANGER_ICI@postgres:5432/syntra
REDIS_URL=redis://redis:6379

# Chiffrement au repos : "id:base64(32 octets)". Ajouter une 2e clé pour la rotation et changer MASTER_KEY_CURRENT.
MASTER_KEYS=k1:
MASTER_KEY_CURRENT=k1

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
AUTH_SECRET=
AUTH_URL=https://console.exemple.fr
API_PORT=4000

# Jamais en production : AUTH_DEV_BYPASS (contournement de connexion de développement)

# Opérateur : autoriser des hôtes en réseau privé pour RCON / statut (désactivé = protection SSRF)
# ALLOW_PRIVATE_RCON=1
# ALLOW_PRIVATE_STATUS=1
