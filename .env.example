# --- Base de données / cache ---
DATABASE_URL=postgresql://syntra:syntra@localhost:5432/syntra
REDIS_URL=redis://localhost:6379

# --- Chiffrement au repos (AES-256-GCM) ---
# Format : "id:base64(32 octets),id2:base64(32 octets)". Générer : openssl rand -base64 32
MASTER_KEYS=k1:CHANGE_ME_BASE64_32_BYTES
MASTER_KEY_CURRENT=k1

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Dashboard (Auth.js) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- API ---
API_PORT=4000
INTERNAL_API_TOKEN=

# --- Opérateur : autoriser des hôtes en réseau privé (désactivé par défaut = protection SSRF) ---
# ALLOW_PRIVATE_RCON=1
# ALLOW_PRIVATE_STATUS=1
